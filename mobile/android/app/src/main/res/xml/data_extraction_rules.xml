<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The widget's session token and the WebView's (gripello_auth cookie) stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gripello.widget.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gripello.widget.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
