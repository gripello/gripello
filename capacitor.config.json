{
    "appId": "app.gripello",
    "appName": "Gripello",
    "webDir": "mobile/www",
    "appendUserAgent": "GripelloApp",
    "server": { "url": "https://gripello.app" },
    "android": {
        "path": "mobile/android",
        "appendUserAgent": "GripelloApp/android"
    },
    "ios": {
        "path": "mobile/ios",
        "appendUserAgent": "GripelloApp/ios",
        "limitsNavigationsToAppBoundDomains": true
    },
    "plugins": {
        "SystemBars": { "initialViewportFitValueHint": "cover" },
        "SplashScreen": { "launchShowDuration": 3000 }
    }
}
