{
    "name": "gripello",
    "version": "2.2.0",
    "private": true,
    "type": "module",
    "license": "BUSL-1.1",
    "scripts": {
        "build": "nuxt build",
        "dev": "CAP_SECRET=${CAP_SECRET:-dev-only-cap-secret-not-for-production} concurrently \"nuxt dev\" \"yarn dev:db\"",
        "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait && cd backend && GRIPELLO_ENV=dev go run github.com/air-verse/air@v1.67.4",
        "start:db": "cd backend && GRIPELLO_ENV=dev go run ./cmd/gripello serve --http=:8099",
        "import:pb": "cd backend && GRIPELLO_ENV=dev go run ./cmd/gripello import-pocketbase --pb-data ../pocketbase/pb_data",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "format": "prettier --write \"**/*.{js,ts,vue,html,css,json}\"",
        "release": "release-it",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:go": "cd backend && go test ./...",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "e2e:up": "./e2e/scripts/app-up.sh",
        "loadtest": "docker run --rm -i --network host -e BASE_URL -e VUS -e DURATION -e THINK_S -e SEED_ROUTES -e PB_SUPERUSER_EMAIL -e PB_SUPERUSER_PASSWORD -v \"$PWD/loadtest:/scripts:ro,z\" grafana/k6 run /scripts/public-users.ts",
        "e2e:down": "./e2e/scripts/app-down.sh"
    },
    "devDependencies": {
        "@cap.js/wasm": "0.0.8",
        "@cj-tech-master/excelts": "10.2.0",
        "@iconify-json/lucide": "^1.2.140",
        "@iconify-json/simple-icons": "^1.2.99",
        "@nuxt/ui": "^4.11.3",
        "@nuxtjs/i18n": "10.6.0",
        "@playwright/test": "^1.63.0",
        "@types/leaflet": "^1.9.22",
        "@types/pdfkit": "0.17.6",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.9",
        "@vue/test-utils": "2.5.1",
        "cap-widget": "^0.1.58",
        "capjs-core": "^0.1.3",
        "concurrently": "10.0.5",
        "echarts": "6.1.0",
        "h3": "1.15.11",
        "happy-dom": "20.14.5",
        "leaflet": "^1.9.4",
        "nuxt": "^4.6.0",
        "pako": "^3.0.2",
        "pdfkit": "0.20.2",
        "prettier": "3.9.9",
        "qrcode": "1.5.4",
        "release-it": "21.1.0",
        "tailwindcss": "^4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.3",
        "vue": "3.5.43",
        "zxing-wasm": "3.1.5"
    },
    "browserslist": [
        "defaults and fully supports es6-module"
    ],
    "packageManager": "yarn@4.18.0",
    "release-it": {
        "$schema": "https://unpkg.com/release-it/schema/release-it.json",
        "git": {
            "tagName": "v${version}",
            "commitMessage": "release v${version}",
            "requireCleanWorkingDir": true,
            "push": true
        }
    },
    "resolutions": {
        "vue": "3.5.43"
    }
}
