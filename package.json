{
    "name": "gripello",
    "version": "2.3.4",
    "private": true,
    "type": "module",
    "license": "BUSL-1.1",
    "scripts": {
        "build": "nuxt build",
        "dev": "CAP_SECRET=${CAP_SECRET:-dev-only-cap-secret-not-for-production} concurrently \"nuxt dev\" \"yarn dev:db\"",
        "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait && cd backend && GRIPELLO_ENV=dev go tool -modfile=tools/go.mod air",
        "start:db": "cd backend && GRIPELLO_ENV=dev go run ./cmd/gripello serve --http=:8099",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "format": "prettier --write \"**/*.{js,ts,vue,html,css,json}\"",
        "release": "release-it",
        "test": "vitest run",
        "api:types": "npx -y -p openapi-typescript@7.13.0 sh -c 'for f in api/*.yaml; do openapi-typescript \"$f\" -o \"${1:-types/api}/$(basename \"$f\" .yaml).ts\" || exit 1; done' api-types",
        "api:types:check": "sh -c 'dir=$(mktemp -d) && yarn api:types \"$dir\" && diff -r types/api \"$dir\"; status=$?; rm -rf \"$dir\"; exit $status' api-types-check",
        "typecheck": "nuxi prepare && npx -y -p vue-tsc@3.3.11 -p typescript@5.9.3 vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
        "test:watch": "vitest",
        "test:go": "cd backend && go test -parallel 4 ./...",
        "db:drift": "sh -c 'cd backend && GRIPELLO_DRIFT_DSN=\"${DATABASE_URL:-postgres://postgres:dev@localhost:5433/gripello?sslmode=disable}\" go test -count=1 -v -run TestSchemaMatchesMigrations ./internal/platform/db'",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "e2e:up": "./e2e/scripts/app-up.sh",
        "loadtest": "cd loadtest && go run .",
        "loadtest:seed": "sh -c '${PSQL:-docker run --rm -i --network host postgres:18-alpine psql ${DATABASE_URL:-postgres://postgres:dev@localhost:5433/gripello}} -q \"$@\" < loadtest/seed.sql' seed",
        "e2e:down": "./e2e/scripts/app-down.sh",
        "cap:android": "cap run android",
        "cap:dev": "cap run android --live-reload --port 3000 --host",
        "cap:ios": "cap run ios",
        "cap:dev:ios": "cap run ios --live-reload --port 3000 --host localhost",
        "cap:sync": "cap sync",
        "capacitor:copy:before": "cp public/offline.html public/icon-192.png mobile/www/"
    },
    "devDependencies": {
        "@cap.js/wasm": "0.0.8",
        "@capacitor/android": "8.5.3",
        "@capacitor/app": "8.1.2",
        "@capacitor/browser": "8.0.5",
        "@capacitor/cli": "8.5.3",
        "@capacitor/core": "8.5.3",
        "@capacitor/filesystem": "8.1.5",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/ios": "8.5.3",
        "@capacitor/push-notifications": "8.1.3",
        "@capacitor/share": "8.0.3",
        "@capacitor/splash-screen": "8.0.2",
        "@cj-tech-master/excelts": "10.2.0",
        "@iconify-json/lucide": "^1.2.147",
        "@iconify-json/simple-icons": "^1.2.100",
        "@nuxt/ui": "^4.12.0",
        "@nuxtjs/i18n": "10.6.0",
        "@playwright/test": "^1.64.1",
        "@types/pdfkit": "0.17.6",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "@vueuse/core": "15.0.0",
        "cap-widget": "^0.1.58",
        "capjs-core": "^0.1.5",
        "concurrently": "10.0.6",
        "echarts": "6.1.0",
        "h3": "1.15.11",
        "happy-dom": "21.0.4",
        "maplibre-gl": "^6.15.0",
        "nuxt": "^4.6.3",
        "pako": "^3.0.2",
        "pdfkit": "0.20.2",
        "prettier": "3.9.10",
        "qrcode": "1.5.4",
        "release-it": "21.1.1",
        "tailwindcss": "^4.3.3",
        "vite": "8.3.4",
        "vitest": "5.0.5",
        "vue": "3.5.44",
        "zxing-wasm": "3.1.6"
    },
    "browserslist": [
        "defaults and fully supports es6-module"
    ],
    "packageManager": "yarn@4.18.1",
    "release-it": {
        "$schema": "https://unpkg.com/release-it/schema/release-it.json",
        "git": {
            "tagName": "v${version}",
            "commitMessage": "release v${version}",
            "requireCleanWorkingDir": true,
            "push": true
        }
    },
    "resolutions": {
        "vue": "3.5.44"
    }
}
