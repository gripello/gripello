{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "skipLibCheck": true,
        "paths": {
            "~/*": ["../*"],
            "#shared/*": ["../shared/*"]
        }
    },
    "include": ["support/*.ts", "specs/**/*.ts", "../playwright.config.ts"]
}
